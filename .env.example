# 复制为 .env 后填写（勿将 .env 提交到 Git）
# cp .env.example .env

# ── 大模型 API（解释生成 / LLM-as-a-Judge / GPT 基线）──────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 解释质量评测专用（可与上面相同）
JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_MODEL=gpt-4o-mini

# 专家解释子集批量生成
EXPLAIN_GEN_MODEL=gpt-4o-mini

# ── 本地 HuggingFace 模型（可选，覆盖默认 Hub ID）────────────────
# MISTRAL_BASE_MODEL=mistralai/Mistral-7B-Instruct-v0.2
# LLAMA_EXPERT_BASE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# LLAMA_EXPERT_LORA_PATH=/path/to/expert_lora
# BERT_BASE_MODEL=bert-base-uncased
# DISTILBERT_BASE_MODEL=distilbert-base-uncased
